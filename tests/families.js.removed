var famBad=0;
FAMILY_CASES.forEach(function(c){ var k=lgFamily(c[0],c[1]).key; if(k!==c[2]){ famBad++; print('FAIL family  '+c[0]+'\n       want '+c[2]+'\n       got  '+k); } });
